{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "docker-compose",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "separateMinorPatch": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Qualify Docker Hub images that have no explicit registry",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["!/^(?:[^/]*[.:][^/]*|localhost)\\//", "!scratch"],
      "replacementNameTemplate": "docker.io/{{{packageName}}}"
    },
    {
      "description": "Keep Compose image versions under manual maintenance",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": "Include indirect modules in routine maintenance",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Keep the minimum Go version current with the build image",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "One application maintenance PR for minor and patch releases",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "application dependencies",
      "groupSlug": "application-dependencies"
    },
    {
      "description": "Group minor and patch updates to smoke-test images separately",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["scripts/smoke.py"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "smoke-test dependencies",
      "groupSlug": "smoke-test-dependencies"
    },
    {
      "description": "Leave pins, digests, replacements, and rollbacks for manual maintenance",
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest",
        "replacement",
        "rollback",
        "bump"
      ],
      "enabled": false
    },
    {
      "description": "Show major upgrades in the dashboard and wait for approval",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Allow registry qualification despite the default replacement policy",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["!/^(?:[^/]*[.:][^/]*|localhost)\\//", "!scratch"],
      "matchUpdateTypes": ["replacement"],
      "enabled": true
    },
    {
      "description": "The scheduler image is built locally, not fetched from a registry",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["container-scheduler", "docker.io/container-scheduler"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "Requires Go (?<currentValue>\\d+\\.\\d+\\.\\d+) or newer\\."
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/smoke\\.py$/"],
      "matchStrings": [
        "['\"](?<depName>docker\\.io/[a-z0-9._/-]+):(?<currentValue>[a-zA-Z0-9._-]+)['\"]"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "labels": [
    "dependencies",
    "bot"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "groupSingleUpdates": true,
  "ignoreUnstable": true,
  "logLevelRemap": [
    {
      "matchMessage": "/^Error updating branch$/",
      "newLogLevel": "error"
    }
  ]
}
