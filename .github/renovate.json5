{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "separateMinorPatch": false,
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Include indirect modules in routine maintenance",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true
    },
    {
      "description": "Keep the minimum Go version current with the build image",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "One application maintenance PR for minor and patch releases",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "application dependencies",
      "groupSlug": "application-dependencies"
    },
    {
      "description": "Leave pins, digests, replacements, and rollbacks for manual maintenance",
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest",
        "replacement",
        "rollback",
        "bump"
      ],
      "enabled": false
    },
    {
      "description": "Show major upgrades in the dashboard and wait for approval",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "Requires Go (?<currentValue>\\d+\\.\\d+\\.\\d+) or newer\\."
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    }
  ],
  "labels": [
    "dependencies",
    "bot"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "groupSingleUpdates": true,
  "ignoreUnstable": true,
  "logLevelRemap": [
    {
      "matchMessage": "/^Error updating branch$/",
      "newLogLevel": "error"
    }
  ]
}
